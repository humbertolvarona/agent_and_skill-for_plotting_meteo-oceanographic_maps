{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny"
    },
    "edit": {
      "*": "deny",
      "src/*.py": "allow",
      "src/**/*.py": "allow",
      "tests/*.py": "allow",
      "tests/**/*.py": "allow",
      "outputs/maps/*.json": "allow"
    },
    "bash": {
      "*": "ask",
      "python3.12 -m py_compile *": "allow",
      "python3.12 -c *": "allow",
      "python3.12 src/*.py *": "ask",
      "python3.12 src/**/*.py *": "ask",
      "rm *": "deny",
      "sudo *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "pip *": "deny",
      "python3.12 -m pip *": "deny"
    },
    "external_directory": "deny",
    "skill": {
      "*": "deny",
      "cartopy-map-production": "allow"
    },
    "webfetch": "deny",
    "websearch": "deny"
  },
  "agent": {
    "build": {
      "temperature": 0.1,
      "permission": {
        "skill": {
          "*": "deny",
          "cartopy-map-production": "allow"
        },
        "task": {
          "*": "deny",
          "cartopy-map-reviewer": "allow"
        }
      }
    }
  }
}
